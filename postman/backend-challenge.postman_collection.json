{
  "info": {
    "_postman_id": "166733aa-1f37-4907-a927-a3f9d4d93a47",
    "name": "Backend Challenge - User Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Echo User Management API. Start the API and MongoDB, then run requests in numerical order or use Collection Runner. No environment import is required. base_url defaults to http://localhost:8080. Register generates fresh demo emails and saves user_id; Login saves access_token. Business input is JSON body only; JWT uses Authorization. Expected 401/403 requests have passing assertions for those statuses. The final cleanup requests delete both demo accounts created by this run. Use a local/test database."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "name",
      "value": "Postman Primary User",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "PostmanDemo123!",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "other_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "other_user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "other_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "updated_email",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 Authentication",
      "item": [
        {
          "name": "01 Register primary user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "description": "Start here. Generates fresh unique demo emails for each run and resets saved IDs/tokens. Saves user_id after successful registration.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runID = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('email', 'postman.' + runID + '@example.com');",
                  "pm.collectionVariables.set('other_email', 'postman.other.' + runID + '@example.com');",
                  "pm.collectionVariables.set('updated_email', 'postman.updated.' + runID + '@example.com');",
                  "['access_token', 'user_id', 'other_user_id', 'other_access_token'].forEach(function (key) { pm.collectionVariables.set(key, ''); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"No password fields in response\", function () {",
                  "    const rows = Array.isArray(pm.response.json()) ? pm.response.json() : [pm.response.json()];",
                  "    rows.forEach(function (row) {",
                  "        pm.expect(row).not.to.have.property(\"password\");",
                  "        pm.expect(row).not.to.have.property(\"password_hash\");",
                  "        pm.expect(row).not.to.have.property(\"PasswordHash\");",
                  "    });",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"user_id\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login primary user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Saves access_token. Protected requests inherit bearer authentication from the collection.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.test('Bearer token returned', function () {",
                  "        pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "        pm.expect(response.token_type).to.eql('Bearer');",
                  "        pm.expect(response.expires_in).to.be.above(0);",
                  "    });",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 User operations",
      "item": [
        {
