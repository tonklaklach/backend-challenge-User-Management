    },
    {
      "name": "3 Cleanup (deletes demo accounts)",
      "item": [
        {
          "name": "09 Login secondary user for cleanup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Gets a separate token for deleting the secondary account. Does not replace the primary access_token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{other_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"other_access_token\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Delete secondary user",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "Deletes only the secondary account created by this run, using its own token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{other_access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{other_user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) {",
                  "    pm.test('Response body is empty', function () { pm.expect(pm.response.text()).to.eql(''); });",
                  "    pm.collectionVariables.set('other_access_token', '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Delete primary user",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "Run last: deletes the primary demo account and clears access_token. Run Register and Login again to start over.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
