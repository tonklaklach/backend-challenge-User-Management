          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/users/get",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"No password fields in response\", function () {",
                  "    const rows = Array.isArray(pm.response.json()) ? pm.response.json() : [pm.response.json()];",
                  "    rows.forEach(function (row) {",
                  "        pm.expect(row).not.to.have.property(\"password\");",
                  "        pm.expect(row).not.to.have.property(\"password_hash\");",
                  "        pm.expect(row).not.to.have.property(\"PasswordHash\");",
                  "    });",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Correct user returned\", function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"user_id\")); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 List users",
          "request": {
            "method": "GET",
            "header": [

            ],
            "url": "{{base_url}}/users",
            "description": ""
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"No password fields in response\", function () {",
                  "    const rows = Array.isArray(pm.response.json()) ? pm.response.json() : [pm.response.json()];",
                  "    rows.forEach(function (row) {",
                  "        pm.expect(row).not.to.have.property(\"password\");",
                  "        pm.expect(row).not.to.have.property(\"password_hash\");",
                  "        pm.expect(row).not.to.have.property(\"PasswordHash\");",
                  "    });",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Users returned as an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Cannot update another user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "Expected 403. Uses the primary token with the secondary user ID to verify ownership enforcement.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{other_user_id}}\",\n  \"name\": \"Must not be applied\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Error message is present\", function () { pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Reject missing JWT",
          "request": {
            "method": "GET",
            "header": [

            ],
            "url": "{{base_url}}/users",
            "description": "Expected 401. Overrides inherited authentication with No Auth.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Error message is present\", function () { pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
