          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/users",
            "description": "Updates the primary account. Updates the saved email so Login continues to work afterwards.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{user_id}}\",\n  \"name\": \"Postman Updated User\",\n  \"email\": \"{{updated_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [

          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"No password fields in response\", function () {",
                  "    const rows = Array.isArray(pm.response.json()) ? pm.response.json() : [pm.response.json()];",
                  "    rows.forEach(function (row) {",
                  "        pm.expect(row).not.to.have.property(\"password\");",
                  "        pm.expect(row).not.to.have.property(\"password_hash\");",
                  "        pm.expect(row).not.to.have.property(\"PasswordHash\");",
                  "    });",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.test('Changes persisted in response', function () {",
                  "        pm.expect(response.name).to.eql('Postman Updated User');",
                  "        pm.expect(response.email).to.eql(pm.collectionVariables.get('updated_email'));",
                  "    });",
                  "    pm.collectionVariables.set('email', response.email);",
                  "}"
